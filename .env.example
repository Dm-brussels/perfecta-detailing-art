# ─── Emails (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=
QUOTE_EMAIL_TO=perfectadetailingart@gmail.com
QUOTE_EMAIL_FROM="Perfecta Detailing Art <info@perfectadetailing.be>"

# ─── Espace privé /leads ───────────────────────────────────────────
# Code d'accès au dashboard. Jamais exposé au navigateur.
LEADS_PASSWORD=5831
# Clé de signature des sessions ET de chiffrement des leads stockés.
# À définir une fois pour toutes : la changer rend les leads déjà
# enregistrés illisibles.
LEADS_SECRET=

# ─── Stockage persistant (Vercel Blob) ─────────────────────────────
# Fourni automatiquement par Vercel une fois le store connecté au projet.
# Absent en local : les leads sont écrits dans ./.data
BLOB_READ_WRITE_TOKEN=

# ─── Tracking (optionnel) ──────────────────────────────────────────
# Renseigner l'un OU l'autre. GTM prend le dessus s'il est défini.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
